# ==========================================
# UNICOM UNIVERSITY — Environment Variables Template
# ==========================================

# 1. Global Database & Redis
DATABASE_URL="postgresql://unicom_admin:unicom_secure_password_2026!@localhost:5432/unicom_university?schema=public"
REDIS_URL="redis://localhost:6379"

# 2. Backend API (@unicom/api)
PORT=4000
NODE_ENV="development"
JWT_SECRET="unicom_university_development_secret_key_2026"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="unicom_university_refresh_secret_key_2026"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# 3. Frontend Web (@unicom/web)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# 4. Storage & Media (AWS S3 / Cloudflare R2)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET_NAME="unicom-university-assets-prod"

# 5. AI Service Providers (Google Gemini / OpenAI)
GEMINI_API_KEY="your_google_gemini_api_key"
OPENAI_API_KEY="your_openai_api_key"
