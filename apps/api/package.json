{
  "name": "@unicom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test e2e --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c ../../playwright.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@unicom/config": "workspace:*",
    "@unicom/database": "workspace:*",
    "@unicom/types": "workspace:*",
    "@unicom/validation": "workspace:*",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.20.2",
    "pino": "^9.7.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "vitest": "^3.1.2"
  }
}
