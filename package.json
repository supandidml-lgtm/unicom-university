{
  "name": "unicom-university",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @unicom/api test:e2e",
    "test:load": "node scripts/task017-load-test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @unicom/database db:generate",
    "db:migrate": "pnpm --filter @unicom/database db:migrate",
    "db:seed": "pnpm --filter @unicom/database db:seed",
    "db:studio": "pnpm --filter @unicom/database db:studio",
    "admin:bootstrap": "pnpm --filter @unicom/api exec tsx scripts/bootstrap-super-admin.ts",
    "certificate:backfill": "pnpm --filter @unicom/api exec tsx scripts/backfill-certificates.ts",
    "operations:cleanup": "pnpm --filter @unicom/api exec tsx scripts/cleanup-expired-operational-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  }
}
