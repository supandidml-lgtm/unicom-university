{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=@unicom/types && npm run build --workspace=@unicom/config && npm run build --workspace=@unicom/validation && npm run build --workspace=@unicom/ui && cd apps/web && npx next build",
  "outputDirectory": "apps/web/.next",
  "regions": ["sin1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://unicom-university-production.up.railway.app/api/v1",
    "NEXT_PUBLIC_APP_URL": "https://unicom-university-web.vercel.app",
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
